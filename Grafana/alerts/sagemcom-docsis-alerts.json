{
  "name": "Sagemcom DOCSIS Modem",
  "interval": 60,
  "rules": [
    {
      "uid": "sagemcom-gui-down",
      "title": "Sagemcom DOCSIS — Modem GUI unreachable",
      "condition": "Threshold",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 300, "to": 0},
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
            "expr": "sagemcom_gui_up",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "Threshold",
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {"params": [1], "type": "lt"},
                "operator": {"type": "and"},
                "query": {"params": ["A"]},
                "reducer": {"params": [], "type": "last"},
                "type": "query"
              }
            ],
            "datasource": {"type": "__expr__", "uid": "-100"},
            "expression": "A",
            "refId": "Threshold",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Error",
      "for": "3m",
      "labels": {"severity": "critical", "team": "homelab", "service": "sagemcom-docsis"},
      "annotations": {
        "summary": "Modem management GUI is unreachable",
        "description": "sagemcom_gui_up has been 0 for 3m. The exporter cannot reach https://192.168.100.1/2.0/gui/.\n\nCheck modem power, LAN path to the bridge management address, and the exporter host. Missing series is handled by the exporter-stale rule, not this one."
      }
    },
    {
      "uid": "sagemcom-docsis-scrape-down",
      "title": "Sagemcom DOCSIS — DOCSIS scrape failed",
      "condition": "Threshold",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 300, "to": 0},
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
            "expr": "sagemcom_docsis_scrape_up",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "Threshold",
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {"params": [1], "type": "lt"},
                "operator": {"type": "and"},
                "query": {"params": ["A"]},
                "reducer": {"params": [], "type": "last"},
                "type": "query"
              }
            ],
            "datasource": {"type": "__expr__", "uid": "-100"},
            "expression": "A",
            "refId": "Threshold",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Error",
      "for": "5m",
      "labels": {"severity": "warning", "team": "homelab", "service": "sagemcom-docsis"},
      "annotations": {
        "summary": "DOCSIS JSON-RPC scrape is failing",
        "description": "sagemcom_docsis_scrape_up has been 0 for 5m. GUI may still be up, but channel tables are not collecting.\n\nCheck modem login lockouts, MODEM_USERNAME/PASSWORD, and JSON-RPC session errors."
      }
    },
    {
      "uid": "sagemcom-internet-path-down",
      "title": "Sagemcom DOCSIS — Internet path probes down",
      "condition": "Threshold",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 300, "to": 0},
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
            "expr": "min(sagemcom_internet_probe_up)",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "Threshold",
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {"params": [1], "type": "lt"},
                "operator": {"type": "and"},
                "query": {"params": ["A"]},
                "reducer": {"params": [], "type": "last"},
                "type": "query"
              }
            ],
            "datasource": {"type": "__expr__", "uid": "-100"},
            "expression": "A",
            "refId": "Threshold",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Error",
      "for": "5m",
      "labels": {"severity": "critical", "team": "homelab", "service": "sagemcom-docsis"},
      "annotations": {
        "summary": "All exporter public TCP probes are down",
        "description": "min(sagemcom_internet_probe_up) has been 0 for 5m. This is a symptom of WAN failure, not proof of an ISP outage by itself.\n\nCorrelate with modem GUI/DOCSIS status and UniFi WAN metrics before contacting the ISP."
      }
    },
    {
      "uid": "sagemcom-modem-restarted",
      "title": "Sagemcom DOCSIS — Modem restarted",
      "condition": "Threshold",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 900, "to": 0},
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
            "expr": "delta(sagemcom_uptime_seconds[15m])",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "Threshold",
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {"params": [-60], "type": "lt"},
                "operator": {"type": "and"},
                "query": {"params": ["A"]},
                "reducer": {"params": [], "type": "last"},
                "type": "query"
              }
            ],
            "datasource": {"type": "__expr__", "uid": "-100"},
            "expression": "A",
            "refId": "Threshold",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Error",
      "for": "0s",
      "labels": {"severity": "warning", "team": "homelab", "service": "sagemcom-docsis"},
      "annotations": {
        "summary": "Modem uptime decreased (restart detected)",
        "description": "sagemcom_uptime_seconds dropped by more than 60s over 15m. The modem rebooted or lost registration long enough to reset uptime.\n\nCheck DOCSIS SNR/power, uncorrectables, and whether this correlates with WAN loss."
      }
    },
    {
      "uid": "sagemcom-ds-snr-low",
      "title": "Sagemcom DOCSIS — Downstream SNR low",
      "condition": "Threshold",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 300, "to": 0},
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
            "expr": "min(sagemcom_docsis_downstream_snr_db)",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "Threshold",
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {"params": [33], "type": "lt"},
                "operator": {"type": "and"},
                "query": {"params": ["A"]},
                "reducer": {"params": [], "type": "last"},
                "type": "query"
              }
            ],
            "datasource": {"type": "__expr__", "uid": "-100"},
            "expression": "A",
            "refId": "Threshold",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Error",
      "for": "10m",
      "labels": {"severity": "warning", "team": "homelab", "service": "sagemcom-docsis"},
      "annotations": {
        "summary": "Lowest downstream SNR is {{ $values.A }} dB",
        "description": "min(sagemcom_docsis_downstream_snr_db) has been below 33 dB for 10m (QAM256 target is typically ≥33–35 dB).\n\nThis often indicates plant noise/ingress. Capture channel SNR/power before contacting your ISP."
      }
    },
    {
      "uid": "sagemcom-us-power-high",
      "title": "Sagemcom DOCSIS — Upstream power high",
      "condition": "Threshold",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 300, "to": 0},
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
            "expr": "max(sagemcom_docsis_channel_power_dbmv{direction=\"upstream\"})",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "Threshold",
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {"params": [51], "type": "gt"},
                "operator": {"type": "and"},
                "query": {"params": ["A"]},
                "reducer": {"params": [], "type": "last"},
                "type": "query"
              }
            ],
            "datasource": {"type": "__expr__", "uid": "-100"},
            "expression": "A",
            "refId": "Threshold",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Error",
      "for": "10m",
      "labels": {"severity": "warning", "team": "homelab", "service": "sagemcom-docsis"},
      "annotations": {
        "summary": "Upstream power at {{ $values.A }} dBmV",
        "description": "max upstream power has been above 51 dBmV for 10m. Levels near the modem's transmit ceiling often precede upstream timeouts / partial service.\n\nCheck splitters/cabling; escalate to your ISP if persistent."
      }
    },
    {
      "uid": "sagemcom-uncorrectables",
      "title": "Sagemcom DOCSIS — Uncorrectable codewords rising",
      "condition": "Threshold",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 600, "to": 0},
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
            "expr": "sum(rate(sagemcom_docsis_downstream_codewords_total{type=\"uncorrectable\"}[10m]))",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "Threshold",
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {"params": [0], "type": "gt"},
                "operator": {"type": "and"},
                "query": {"params": ["A"]},
                "reducer": {"params": [], "type": "last"},
                "type": "query"
              }
            ],
            "datasource": {"type": "__expr__", "uid": "-100"},
            "expression": "A",
            "refId": "Threshold",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Error",
      "for": "10m",
      "labels": {"severity": "warning", "team": "homelab", "service": "sagemcom-docsis"},
      "annotations": {
        "summary": "Uncorrectable DOCSIS codewords are increasing",
        "description": "sum(rate(...uncorrectable...[10m])) > 0 for 10m. Unlike OFDM correctable FEC chatter, uncorrectables mean frames are being lost.\n\nCapture per-channel SNR/power and open a ticket with your ISP if this persists with service impact."
      }
    },
    {
      "uid": "sagemcom-channel-unlocked",
      "title": "Sagemcom DOCSIS — DOCSIS channel unlocked",
      "condition": "Threshold",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 300, "to": 0},
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
            "expr": "min(sagemcom_docsis_channel_lock)",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "Threshold",
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {"params": [1], "type": "lt"},
                "operator": {"type": "and"},
                "query": {"params": ["A"]},
                "reducer": {"params": [], "type": "last"},
                "type": "query"
              }
            ],
            "datasource": {"type": "__expr__", "uid": "-100"},
            "expression": "A",
            "refId": "Threshold",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "NoData",
      "execErrState": "Error",
      "for": "5m",
      "labels": {"severity": "warning", "team": "homelab", "service": "sagemcom-docsis"},
      "annotations": {
        "summary": "At least one DOCSIS channel is unlocked",
        "description": "min(sagemcom_docsis_channel_lock) has been 0 for 5m. Partial channel loss often precedes flaky WAN or modem restarts."
      }
    },
    {
      "uid": "sagemcom-exporter-stale",
      "title": "Sagemcom DOCSIS — Exporter metrics stale",
      "condition": "Threshold",
      "data": [
        {
          "refId": "A",
          "relativeTimeRange": {"from": 1200, "to": 0},
          "datasourceUid": "grafanacloud-prom",
          "model": {
            "datasource": {"type": "prometheus", "uid": "grafanacloud-prom"},
            "expr": "(time() - max(timestamp(sagemcom_gui_up)) > bool 900) or vector(0)",
            "instant": true,
            "refId": "A"
          }
        },
        {
          "refId": "Threshold",
          "datasourceUid": "-100",
          "model": {
            "conditions": [
              {
                "evaluator": {"params": [0], "type": "gt"},
                "operator": {"type": "and"},
                "query": {"params": ["A"]},
                "reducer": {"params": [], "type": "last"},
                "type": "query"
              }
            ],
            "datasource": {"type": "__expr__", "uid": "-100"},
            "expression": "A",
            "refId": "Threshold",
            "type": "threshold"
          }
        }
      ],
      "noDataState": "Alerting",
      "execErrState": "Error",
      "for": "15m",
      "labels": {"severity": "critical", "team": "homelab", "service": "sagemcom-docsis"},
      "annotations": {
        "summary": "No sagemcom-docsis-exporter metrics for >15 minutes",
        "description": "sagemcom_gui_up has not been scraped in over 15 minutes. Modem health is blind.\n\nCheck docker compose on the exporter host and Alloy scrape for job custom/sagemcom_docsis_exporter."
      }
    }
  ]
}
